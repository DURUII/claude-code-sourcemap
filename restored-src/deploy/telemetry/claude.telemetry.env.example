# Copy this file to restored-src/.claude/telemetry.env and edit locally.
# The target file is ignored by git. Do not commit real hostnames, Tailscale
# domains, public IPs, passwords, or GrowthBook SDK keys.

CLAUDE_RESTORED_TELEMETRY=1
CLAUDE_CODE_ENABLE_TELEMETRY=1

OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://<host>:4318

# Include prompt text, tool parameters, and tool output/content in OTLP.
# This is useful for local source-study diagnostics, but it can contain
# sensitive project data.
OTEL_LOG_USER_PROMPTS=1
OTEL_LOG_TOOL_DETAILS=1
OTEL_LOG_TOOL_CONTENT=1

NO_PROXY=<host>,localhost,127.0.0.1
no_proxy=<host>,localhost,127.0.0.1

CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
CLAUDE_CODE_OTEL_SHUTDOWN_TIMEOUT_MS=5000

CLAUDE_CODE_GB_BASE_URL=http://<host>:3100
CLAUDE_CODE_GB_CLIENT_KEY=<growthbook-sdk-client-key>

CLAUDE_CODE_PERFETTO_TRACE=1
CLAUDE_CODE_PERFETTO_WRITE_INTERVAL_S=5

CLAUDE_RESTORED_KIBANA_URL=http://<host>:5601
CLAUDE_RESTORED_ELASTICSEARCH_URL=http://<host>:9200
CLAUDE_RESTORED_GRAFANA_URL=http://<host>:3001
CLAUDE_RESTORED_GROWTHBOOK_URL=http://<host>:3000
CLAUDE_RESTORED_PROMETHEUS_URL=http://<host>:9090
CLAUDE_RESTORED_TEMPO_URL=http://<host>:3200

# Optional local development diagnostics.
# CLAUDE_RESTORED_DEBUG=1 makes bin/claude add --debug unless a debug flag is
# already present.
CLAUDE_RESTORED_DEBUG=0

# ANTHROPIC_LOG=debug enables Anthropic SDK HTTP-level logging. In interactive
# TUI sessions this is noisy on stderr; prefer the HTTP visualizer below for
# live request inspection.
ANTHROPIC_LOG=warn

# Optional: start lab/http-visualizer first, then set this endpoint to stream
# full API request payloads into the browser UI.
# CLAUDE_CODE_HTTP_VISUALIZER_ENDPOINT=http://127.0.0.1:8788/ingest
