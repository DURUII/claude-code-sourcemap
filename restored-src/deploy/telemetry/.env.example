# Copy to deploy/telemetry/.env on the deployment host and edit before first
# start. This file is for Docker Compose services, not bin/claude runtime env.
# Keep the real .env private. Do not commit hostnames, Tailscale domains,
# public IPs, passwords, or GrowthBook SDK keys.

ELASTIC_VERSION=8.17.4
ES_JAVA_OPTS=-Xms1g -Xmx1g
KIBANA_PUBLIC_BASE_URL=http://<host>:5601
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<grafana-admin-password>

GROWTHBOOK_APP_ORIGIN=http://<host>:3000
GROWTHBOOK_API_HOST=http://<host>:3100
GROWTHBOOK_JWT_SECRET=<random-jwt-secret>
GROWTHBOOK_ENCRYPTION_KEY=<random-encryption-key>

MONGO_INITDB_ROOT_USERNAME=growthbook
MONGO_INITDB_ROOT_PASSWORD=<mongo-root-password>
